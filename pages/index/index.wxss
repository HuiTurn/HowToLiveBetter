.index-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #f3e9d8;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0) 62%,
    rgba(31, 41, 36, 0.28) 100%
  );
}

.index-content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0 64rpx calc(60rpx + env(safe-area-inset-bottom));
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.8s ease;
}

.index-content.show {
  opacity: 1;
  transform: translateY(0);
}

.index-header {
  text-align: center;
}

.index-title {
  display: block;
  font-size: 76rpx;
  font-weight: 700;
  color: #1a3547;
  letter-spacing: 10rpx;
  margin-bottom: 36rpx;
}

.index-subtitle {
  display: block;
  font-size: 28rpx;
  color: #6d7268;
  letter-spacing: 3rpx;
}

.index-spacer {
  flex: 1;
}

.index-script {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 96rpx;
  transform: rotate(-4deg);
}

.script-text {
  font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', 'FZKai-Z03S', serif;
  font-size: 56rpx;
  color: #ffffff;
  letter-spacing: 10rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}

.script-line {
  width: 320rpx;
  height: 28rpx;
  border-bottom: 5rpx solid #ffffff;
  border-radius: 50%;
  margin-top: 16rpx;
}

.index-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.explore-btn {
  width: 76%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #4ba264;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(45, 90, 60, 0.35);
}

.arrow-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 14rpx;
}

.index-footer {
  margin-top: 44rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 1rpx;
}
