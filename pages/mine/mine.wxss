.mine-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.mine-content {
  padding: 24rpx 32rpx 48rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: var(--color-placeholder);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.user-bio {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.user-edit {
  width: 40rpx;
  height: 40rpx;
  padding: 12rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

/* 菜单 */
.menu-list {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 34rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-contact {
  position: relative;
}

.contact-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
}

.menu-item-last {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
}

/* 菜单项副标题（离线下载入口的小字说明），颜色走变量保证深色模式可读 */
.menu-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-tertiary);
}

/* 「离线下载」行右侧的数据更新时间：小字、次要色，顶对齐到主标题行，避免与两行说明挤在一起 */
/* 「离线下载」行第三行：数据更新时间（并入描述区，右对齐的旧方案已废弃） */
.menu-data-updated {
  display: block;
  margin-top: 4rpx;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
  flex-shrink: 0;
}

/* 关注作者公众号 */
.follow-section {
  margin-top: 24rpx;
}

.follow-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.follow-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.follow-info {
  flex: 1;
  min-width: 0;
}

.follow-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.follow-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.follow-btn {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 添加到桌面引导：与「分享到朋友圈」同款，暗罩在导航之下，内容层在导航之上 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 900;
}

.guide-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-ring {
  position: absolute;
  border: 4rpx solid #6ee7b0;
  border-radius: 50%;
  box-shadow: 0 0 24rpx rgba(110, 231, 176, 0.8);
}

.guide-arrow {
  position: absolute;
  width: 164rpx;
  height: 164rpx;
}

.guide-steps {
  margin-top: 320rpx;
  width: 100%;
  padding: 0 110rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  margin-bottom: 56rpx;
}

.guide-num {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #6ee7b0;
  color: #0f2b1c;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.guide-step-text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 700;
}

.guide-tile {
  width: 250rpx;
  background: var(--color-surface-2);
  border-radius: 24rpx;
  padding: 32rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
}

.guide-tile-icon {
  width: 88rpx;
  height: 88rpx;
}

.guide-tile-text {
  font-size: 26rpx;
  color: var(--color-text);
  margin-top: 16rpx;
}

.guide-tagline {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 40rpx;
}

.guide-know {
  margin-top: 64rpx;
  height: 88rpx;
  padding: 0 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
