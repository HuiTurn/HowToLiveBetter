<view class="page mine-page">
  <custom-nav title="我的" align="left" bg-color="#f6f7f6" text-color="#22262b" shadow="{{false}}" />

  <view class="mine-content">
    <!-- 用户信息 -->
    <view class="user-card">
      <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view class="user-info">
        <text class="user-name">{{userInfo.nickname}}</text>
        <text class="user-bio">{{userInfo.bio}}</text>
      </view>
      <image class="user-edit" src="/assets/icons/pencil.png" mode="aspectFit" bindtap="onEditProfile" />
    </view>

    <!-- 菜单 -->
    <view class="menu-list">
      <block wx:for="{{menuList}}" wx:key="id">
        <view
          wx:if="{{item.id === 'feedback'}}"
          class="menu-item menu-item-last menu-item-contact"
          hover-class="hover-press"
        >
          <image class="menu-icon" src="/assets/icons/menu-{{item.icon}}.png" mode="aspectFit" />
          <text class="menu-label">{{item.label}}</text>
          <image class="menu-arrow" src="/assets/icons/chevron.png" mode="aspectFit" />
          <button class="contact-cover" open-type="contact"></button>
        </view>
        <view
          wx:else
          class="menu-item"
          hover-class="hover-press"
          bindtap="onMenuTap"
          data-item="{{item}}"
        >
          <image class="menu-icon" src="/assets/icons/menu-{{item.icon}}.png" mode="aspectFit" />
          <text class="menu-label">{{item.label}}</text>
          <image class="menu-arrow" src="/assets/icons/chevron.png" mode="aspectFit" />
        </view>
      </block>
    </view>
  </view>

  <!-- 添加到桌面引导蒙层（与朋友圈引导同款） -->
  <view wx:if="{{showGuide}}" class="guide-mask" catchtap="onCloseGuide"></view>
  <view wx:if="{{showGuide}}" class="guide-layer" catchtap="onCloseGuide">
    <view class="guide-ring" style="top:{{ringTop}}px; left:{{ringLeft}}px; width:{{ringSize}}px; height:{{ringSize}}px;"></view>
    <image
      class="guide-arrow"
      src="/assets/icons/arrow-curve-white.png"
      mode="aspectFit"
      style="top:{{arrowTop}}px; right:{{arrowRight}}px;"
    />
    <view class="guide-steps">
      <view class="guide-step">
        <view class="guide-num">1</view>
        <text class="guide-step-text">点击右上角「···」</text>
      </view>
      <view class="guide-step">
        <view class="guide-num">2</view>
        <text class="guide-step-text">{{guideStep2}}</text>
      </view>
    </view>
    <view class="guide-tile">
      <image class="guide-tile-icon" src="/assets/icons/menu-desktop.png" mode="aspectFit" />
      <text class="guide-tile-text">{{guideTileText}}</text>
    </view>
    <text class="guide-tagline">{{guideTagline}}</text>
    <view class="guide-know">我知道了</view>
  </view>
</view>
