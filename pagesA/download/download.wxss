.download-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.download-content {
  padding: 40rpx 32rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.dl-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.dl-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.dl-intro {
  display: block;
  font-size: 27rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.dl-formats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dl-tag {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(75, 162, 100, 0.1);
}

.dl-lock {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
}

.dl-lock-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
}

.dl-adfail {
  margin-bottom: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(250, 135, 0, 0.1);
  font-size: 24rpx;
  color: var(--color-orange);
  line-height: 1.5;
}

.dl-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.dl-row.last {
  border-bottom: none;
}

.dl-row-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.dl-row-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
  word-break: break-all;
}

.dl-link {
  color: var(--color-blue);
}

.dl-code {
  font-family: 'SFMono-Regular', Consolas, monospace;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--color-orange);
}

.dl-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.dl-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 20rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  box-shadow: 0 -4rpx 20rpx rgba(31, 41, 36, 0.05);
}

.dl-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--color-primary);
}

.dl-btn.disabled {
  opacity: 0.5;
}

.dl-btn::after {
  border: none;
}
