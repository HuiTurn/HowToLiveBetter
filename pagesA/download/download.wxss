.download-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.download-content {
  padding: 40rpx 32rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.dl-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.dl-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.dl-intro {
  display: block;
  font-size: 27rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.dl-formats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dl-tag {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(75, 162, 100, 0.1);
}

.dl-lock {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
}

.dl-lock-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
}

.dl-lock-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.6;
  text-align: center;
}

.dl-adfail {
  margin-bottom: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(250, 135, 0, 0.1);
  font-size: 24rpx;
  color: var(--color-orange);
  line-height: 1.5;
}

.dl-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.dl-row.last {
  border-bottom: none;
}

.dl-row-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.dl-row-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.6;
  word-break: break-all;
}

.dl-link {
  color: var(--color-blue);
}

.dl-code {
  font-family: 'SFMono-Regular', Consolas, monospace;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--color-orange);
}

/* 文件清单：每行一个格式，右侧独立复制按钮 */
.dl-file {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.dl-file:last-of-type {
  border-bottom: none;
}

.dl-file-main {
  flex: 1;
  min-width: 0;
}

.dl-file-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dl-file-badge {
  padding: 4rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(75, 162, 100, 0.1);
}

/* 次要信息用 secondary 而非 tertiary：深色模式下 tertiary 过暗，小字看不清 */
.dl-file-size {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.dl-file-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.dl-file-name {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.dl-file-act {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-border);
}

.dl-file-act:active {
  background: rgba(75, 162, 100, 0.08);
}

/* 下载中：进度数字，占固定宽度避免按钮宽度跳动 */
.dl-file-busy {
  min-width: 130rpx;
  text-align: center;
  color: var(--color-text-secondary);
}

/* 加速源和直链都失败后露出的备用地址 */
.dl-fallback {
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: var(--color-surface-2);
}

.dl-fallback-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.dl-fallback-row {
  display: flex;
  align-items: center;
}

/* 备用链接行：和上一行拉开一点，视觉上区分主次 */
.dl-fallback-row-sub {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--color-border);
}

.dl-fallback-url {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  word-break: break-all;
  line-height: 1.5;
}

.dl-fallback-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 微信原始报错：字号更小、颜色更浅，只是排查用，不打扰正常阅读 */
.dl-fallback-err {
  display: block;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  word-break: break-all;
  line-height: 1.5;
}

.dl-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.dl-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 20rpx 32rpx 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  box-shadow: 0 -4rpx 20rpx rgba(31, 41, 36, 0.05);
}

.dl-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--color-primary);
}

.dl-btn.disabled {
  opacity: 0.5;
}

.dl-btn::after {
  border: none;
}
