.search-page {
  min-height: 100vh;
  background: var(--color-surface);
}

.search-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--color-surface);
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: var(--color-placeholder);
  border-radius: 999rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  padding: 8rpx;
  margin-right: -8rpx;
}

.search-cancel {
  margin-left: 24rpx;
  font-size: 28rpx;
  color: var(--color-primary);
}

.result-tabs {
  display: flex;
  gap: 48rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.tab-item {
  position: relative;
  padding: 20rpx 0 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: color 0.2s ease;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-underline {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: transparent;
}

.tab-item.active .tab-underline {
  background: var(--color-primary);
}

.search-content {
  padding-bottom: 48rpx;
}

.search-section {
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag-item {
  padding: 12rpx 28rpx;
  background: var(--color-placeholder);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.history-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--color-placeholder);
  flex-shrink: 0;
}

.history-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-section {
  padding: 24rpx 32rpx 0;
}

.result-item {
  margin-bottom: 24rpx;
}

.category-result {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: var(--color-surface);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
  margin-bottom: 24rpx;
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.category-glyph {
  width: 48rpx;
  height: 48rpx;
}

.category-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
  overflow: hidden;
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.category-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
  flex-shrink: 0;
}

.loading-wrap {
  padding: 80rpx 0;
}
