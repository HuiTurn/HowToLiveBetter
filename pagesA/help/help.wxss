.help-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.help-content {
  padding: 24rpx 32rpx 64rpx;
}

.help-section {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx var(--color-shadow, rgba(31, 41, 36, 0.04));
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.section-line {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.section-line:last-child {
  margin-bottom: 0;
}

.line-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin: 14rpx 16rpx 0 0;
  flex-shrink: 0;
}

.line-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.help-tip {
  margin-top: 8rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}
