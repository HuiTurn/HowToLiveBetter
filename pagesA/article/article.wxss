.article-page {
  min-height: 100vh;
  background: var(--color-surface);
  padding-bottom: 160rpx;
}

.article-cover {
  width: calc(100% - 64rpx);
  height: 340rpx;
  border-radius: 24rpx;
  margin: 8rpx 32rpx 0;
  background: var(--color-placeholder);
}

/* 标题区 */
.article-header {
  padding: 36rpx 32rpx 0;
}

.article-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  align-items: center;
}

.article-date {
  display: flex;
  align-items: center;
  line-height: 1.7;
}
.date-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}
.date-upd {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.date-sep {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin: 0 8rpx;
}
.date-pub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 摘要框 */
.article-summary-box {
  margin: 32rpx 32rpx 0;
  padding: 26rpx 30rpx;
  background: var(--badge-green-bg);
  border-left: 8rpx solid var(--color-primary);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--badge-green-text);
  line-height: 1.7;
}

/* 正文 */
.article-body {
  padding: 48rpx 32rpx 0;
}

.section-title {
  position: relative;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 28rpx;
  padding-left: 22rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}

.article-paragraph {
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 1.9;
  margin-bottom: 32rpx;
  text-align: justify;
}

/* 导语段里上游 md 的 **加粗** 片段 */
.para-bold {
  font-weight: 600;
}

/* 条号上标：论文引用式，淡绿圆形底 + 品牌绿数字，点击跳到对应条目。
   必须明显浮到文字右上角（vertical-align 抬够高），不能和正文平齐 */
.cite-sup {
  display: inline-block;
  box-sizing: border-box;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  margin: 0 2rpx;
  border-radius: 999rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 600;
  text-align: center;
  vertical-align: 16rpx;
}

/* 步骤列表 */
.steps-section {
  margin-top: 48rpx;
}

.step-item {
  margin-bottom: 40rpx;
  padding-bottom: 36rpx;
  border-bottom: 2rpx solid var(--color-surface-2);
}

.step-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

/* 条号跳转落地时的短暂高亮 */
.step-item.flash {
  animation: step-flash 1.4s ease;
}

@keyframes step-flash {
  0% {
    background: var(--color-primary-light);
  }
  100% {
    background: transparent;
  }
}

/* 标题行：序号 + 标题 + 证据等级 */
.step-head {
  display: flex;
  align-items: flex-start;
}

.step-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.step-index text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.step-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.5;
}

/* 徽章行 */
.step-badges {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 0 62rpx;
}

.badge {
  font-size: 22rpx;
  line-height: 36rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  margin: 0 10rpx 10rpx 0;
  white-space: nowrap;
}

.badge-plain {
  background: var(--color-surface-2);
  color: var(--color-text-secondary);
}

/* 性价比档：作者判断，用蓝色系，与证据等级区分开 */
.badge-ratio-3 {
  background: var(--badge-blue-bg);
  color: var(--badge-blue-text);
  font-weight: 600;
}

.badge-ratio-2 {
  background: var(--color-primary-light);
  color: var(--badge-green-text);
  font-weight: 600;
}

.badge-ratio-1 {
  background: var(--color-surface-2);
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* 证据等级：A 绿 / B 橙 / C 灰 */
.badge-grade-A {
  background: var(--color-primary-light);
  color: var(--badge-green-text);
  font-weight: 600;
}

.badge-grade-B {
  background: var(--badge-yellow-bg);
  color: var(--badge-yellow-text);
  font-weight: 600;
}

.badge-grade-C {
  background: var(--color-surface-2);
  color: var(--color-text-secondary);
  font-weight: 600;
}

.badge-danger {
  background: var(--badge-red-bg);
  color: var(--badge-red-text);
  font-weight: 600;
}

.badge-warn {
  background: var(--badge-yellow-bg);
  color: var(--badge-yellow-text);
  font-weight: 600;
}

/* 说人话：条目主体，用浅绿底 + 左边框与下面的元信息区分 */
.step-plain {
  margin: 18rpx 0 0 62rpx;
  padding: 16rpx 22rpx;
  border-left: 5rpx solid var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 0 10rpx 10rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.75;
}

/* 成本 / 收益 / 备注 */
.step-rows {
  margin: 18rpx 0 0 62rpx;
}

.step-row {
  display: flex;
  margin-bottom: 12rpx;
}

.step-row:last-child {
  margin-bottom: 0;
}

.row-k {
  width: 78rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.75;
}

.row-v {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  line-height: 1.75;
}

.row-note {
  color: var(--color-text-secondary);
}

/* 成本/收益/备注的值：标题已在上面折叠行里，这里不再重复写「成本」二字。
   内容直接与折叠标题左对齐（62rpx），不再额外缩进——上一轮把成本也改成
   无标签的 row-v-only 后，原本为对齐「成本值列」的 78rpx 成了多余右移，已去掉 */
.row-v-only {
  padding-left: 0;
}

/* 收益/备注里上游 md 的 **加粗** 片段 */
.row-bold {
  font-weight: 600;
}

/* 展开 / 收起（收益与备注、参考文献共用）：默认态由 js 决定 */
.fold-toggle {
  display: flex;
  align-items: center;
  margin: 20rpx 0 0 62rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--color-surface-2);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

.fold-arrow {
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 10rpx solid var(--color-text-tertiary);
  margin-right: 10rpx;
  transition: transform 0.2s;
}

.fold-arrow.open {
  transform: rotate(180deg);
}

.fold-cnt {
  color: var(--color-text-tertiary);
}

/* 每条文献独立成行，序号 + 悬挂缩进，长 URL 正常折行不糊成一段 */
.src-body {
  margin: 16rpx 0 0 62rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.src-line {
  display: flex;
  align-items: flex-start;
}

.src-line + .src-line {
  margin-top: 14rpx;
}

.src-idx {
  flex: none;
  width: 46rpx;
  color: var(--color-text-tertiary);
  font-size: 22rpx;
  line-height: 1.85;
}

.src-line-txt {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}

/* 文献里的链接：品牌色提示可点，点击复制链接 */
.src-url {
  color: var(--color-primary);
  word-break: break-all;
}

/* 术语表关键词：品牌色 + 虚线下划线，点一下弹解释（对齐上游检索页的 abbr.term） */
.term {
  color: var(--color-primary);
  border-bottom: 2rpx dotted var(--color-primary);
  padding-bottom: 1rpx;
}

/* 名词解释：底部小窗 */
.term-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: term-mask-in 0.22s ease;
}

.term-sheet {
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 8rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 40rpx var(--color-shadow);
  animation: term-sheet-up 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.term-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-border);
  margin: 12rpx auto 22rpx;
}

.term-head {
  display: flex;
  align-items: center;
}

.term-k {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
}

.term-close {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: var(--color-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.term-close-x {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.term-body {
  max-height: 46vh;
  margin-top: 22rpx;
}

.term-d {
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--color-text-secondary);
}

.term-foot {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.term-from {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.term-btn {
  flex: none;
  height: 76rpx;
  padding: 0 44rpx;
  border-radius: 38rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes term-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes term-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 来源 / */
.source-section {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--color-border);
}

.source-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.source-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.5;
}

/* 相关推荐 */
.related-section {
  padding: 48rpx 32rpx 0;
}

.related-item {
  margin-bottom: 24rpx;
}

/* 底部操作栏 */
.article-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 32rpx;
  /* 按钮下方留出避开屏幕圆角/小横条的基础空白，再叠加系统安全区高度。
     iPhone 的 safe-area-inset-bottom 本身就接近手势条高度，基础值按最小可用取，避免底栏显得空 */
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(31, 41, 36, 0.06);
  z-index: 100;
}

.footer-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  flex: none;
}

.footer-fav .footer-icon {
  margin-right: 0;
}

.footer-fav-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.footer-fav-text.active {
  color: var(--color-orange);
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.footer-btn-solid {
  background: var(--color-primary);
  color: #ffffff;
  margin: 0;
  padding: 0;
}

.footer-btn-solid::after {
  border: none;
}

.footer-btn-outline {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.footer-btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.footer-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.footer-icon.pop {
  animation: star-pop 0.3s ease;
}

@keyframes star-pop {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
  }
}

/* 分享到朋友圈引导：暗罩在导航之下（导航保持亮），内容层在导航之上 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 900;
}

.guide-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-ring {
  position: absolute;
  border: 4rpx solid #6ee7b0;
  border-radius: 50%;
  box-shadow: 0 0 24rpx rgba(110, 231, 176, 0.8);
}

.guide-arrow {
  position: absolute;
  width: 164rpx;
  height: 164rpx;
}

.guide-steps {
  margin-top: 320rpx;
  width: 100%;
  padding: 0 110rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  margin-bottom: 56rpx;
}

.guide-num {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #6ee7b0;
  color: #0f2b1c;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.guide-step-text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 700;
}

.guide-tile {
  width: 250rpx;
  background: var(--color-surface-2);
  border-radius: 24rpx;
  padding: 32rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
}

.guide-tile-icon {
  width: 88rpx;
  height: 88rpx;
}

.guide-tile-text {
  font-size: 26rpx;
  color: var(--color-text);
  margin-top: 16rpx;
}

.guide-tagline {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 40rpx;
}

.guide-know {
  margin-top: 64rpx;
  height: 88rpx;
  padding: 0 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 双击点赞 */
.like-burst {
  position: fixed;
  z-index: 300;
  width: 0;
  height: 0;
  pointer-events: none;
}

.like-burst-icon {
  position: absolute;
  left: -60rpx;
  top: -60rpx;
  width: 120rpx;
  height: 120rpx;
  animation: like-pop 0.7s ease forwards;
}

@keyframes like-pop {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  30% {
    transform: scale(1.25);
    opacity: 1;
  }
  60% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.1) translateY(-40rpx);
    opacity: 0;
  }
}
