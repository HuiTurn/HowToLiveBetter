.article-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 160rpx;
}

.article-cover {
  width: calc(100% - 64rpx);
  height: 340rpx;
  border-radius: 24rpx;
  margin: 8rpx 32rpx 0;
  background: #eef0f0;
}

/* 标题区 */
.article-header {
  padding: 36rpx 32rpx 0;
}

.article-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #22262b;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-left {
  display: flex;
  align-items: center;
}

.meta-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.meta-icon.gap {
  margin-left: 28rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #b6bac0;
}

.article-date {
  font-size: 24rpx;
  color: #b6bac0;
}

/* 摘要框 */
.article-summary-box {
  margin: 32rpx 32rpx 0;
  padding: 26rpx 30rpx;
  background: #edf5ee;
  border-left: 8rpx solid #4ba264;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #4a7a58;
  line-height: 1.7;
}

/* 正文 */
.article-body {
  padding: 48rpx 32rpx 0;
}

.section-title {
  position: relative;
  font-size: 34rpx;
  font-weight: 700;
  color: #22262b;
  margin-bottom: 28rpx;
  padding-left: 22rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: #4ba264;
}

.article-paragraph {
  font-size: 30rpx;
  color: #3a3f45;
  line-height: 1.9;
  margin-bottom: 32rpx;
  text-align: justify;
}

/* 步骤列表 */
.steps-section {
  margin-top: 48rpx;
}

.step-item {
  display: flex;
  margin-bottom: 36rpx;
}

.step-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #4ba264;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-index text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #22262b;
  margin-bottom: 8rpx;
}

.step-desc {
  display: block;
  font-size: 26rpx;
  color: #8a8f98;
  line-height: 1.5;
}

/* 来源 */
.source-section {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #ececec;
}

.source-label {
  display: block;
  font-size: 26rpx;
  color: #8a8f98;
  margin-bottom: 12rpx;
}

.source-text {
  display: block;
  font-size: 26rpx;
  color: #3a3f45;
  line-height: 1.5;
}

/* 相关推荐 */
.related-section {
  padding: 48rpx 32rpx 0;
}

.related-item {
  margin-bottom: 24rpx;
}

/* 底部操作栏 */
.article-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 112rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(31, 41, 36, 0.06);
  z-index: 100;
}

.footer-item {
  display: flex;
  align-items: center;
  margin-right: 56rpx;
}

.footer-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.footer-text {
  font-size: 26rpx;
  color: #8a8f98;
}

.footer-text.active {
  color: #fa8700;
}

.footer-action {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: #4ba264;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
}

.footer-action::after {
  border: none;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}
