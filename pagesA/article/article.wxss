.article-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 160rpx;
}

.article-cover {
  width: calc(100% - 64rpx);
  height: 340rpx;
  border-radius: 24rpx;
  margin: 8rpx 32rpx 0;
  background: #eef0f0;
}

/* 标题区 */
.article-header {
  padding: 36rpx 32rpx 0;
}

.article-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #22262b;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-left {
  display: flex;
  align-items: center;
}

.meta-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.article-date {
  font-size: 24rpx;
  color: #b6bac0;
}

/* 摘要框 */
.article-summary-box {
  margin: 32rpx 32rpx 0;
  padding: 26rpx 30rpx;
  background: #edf5ee;
  border-left: 8rpx solid #4ba264;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #4a7a58;
  line-height: 1.7;
}

/* 正文 */
.article-body {
  padding: 48rpx 32rpx 0;
}

.section-title {
  position: relative;
  font-size: 34rpx;
  font-weight: 700;
  color: #22262b;
  margin-bottom: 28rpx;
  padding-left: 22rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: #4ba264;
}

.article-paragraph {
  font-size: 30rpx;
  color: #3a3f45;
  line-height: 1.9;
  margin-bottom: 32rpx;
  text-align: justify;
}

/* 步骤列表 */
.steps-section {
  margin-top: 48rpx;
}

.step-item {
  margin-bottom: 40rpx;
  padding-bottom: 36rpx;
  border-bottom: 2rpx solid #f2f4f2;
}

.step-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

/* 标题行：序号 + 标题 + 证据等级 */
.step-head {
  display: flex;
  align-items: flex-start;
}

.step-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #4ba264;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.step-index text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.step-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #22262b;
  line-height: 1.5;
}

/* 徽章行 */
.step-badges {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 0 62rpx;
}

.badge {
  font-size: 22rpx;
  line-height: 36rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  margin: 0 10rpx 10rpx 0;
  white-space: nowrap;
}

.badge-plain {
  background: #f0f1f4;
  color: #565a5f;
}

/* 性价比档：作者判断，用蓝色系，与证据等级区分开 */
.badge-ratio-3 {
  background: #e9ecfb;
  color: #3451b2;
  font-weight: 600;
}

.badge-ratio-2 {
  background: #e7f2ec;
  color: #18794e;
  font-weight: 600;
}

.badge-ratio-1 {
  background: #f0f1f4;
  color: #565a5f;
  font-weight: 600;
}

/* 证据等级：A 绿 / B 橙 / C 灰 */
.badge-grade-A {
  background: #e7f2ec;
  color: #18794e;
  font-weight: 600;
}

.badge-grade-B {
  background: #faf3e3;
  color: #915930;
  font-weight: 600;
}

.badge-grade-C {
  background: #f0f1f4;
  color: #565a5f;
  font-weight: 600;
}

.badge-danger {
  background: #fdecec;
  color: #b8272c;
  font-weight: 600;
}

.badge-warn {
  background: #faf3e3;
  color: #915930;
  font-weight: 600;
}

/* 说人话：条目主体，用浅绿底 + 左边框与下面的元信息区分 */
.step-plain {
  margin: 18rpx 0 0 62rpx;
  padding: 16rpx 22rpx;
  border-left: 5rpx solid #4ba264;
  background: #f2f8f3;
  border-radius: 0 10rpx 10rpx 0;
  font-size: 28rpx;
  color: #2f3a33;
  line-height: 1.75;
}

/* 成本 / 收益 / 备注 */
.step-rows {
  margin: 18rpx 0 0 62rpx;
}

.step-more {
  margin: 16rpx 0 0 62rpx;
  padding: 22rpx 24rpx;
  background: #fafbfa;
  border-radius: 12rpx;
}

.step-row {
  display: flex;
  margin-bottom: 12rpx;
}

.step-row:last-child {
  margin-bottom: 0;
}

.row-k {
  width: 78rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8a8f98;
  line-height: 1.75;
}

.row-v {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #5a6069;
  line-height: 1.75;
}

.row-note {
  color: #8a8f98;
}

/* 展开 / 收起收益与备注 */
.step-toggle {
  display: flex;
  align-items: center;
  margin: 18rpx 0 0 62rpx;
  font-size: 24rpx;
  color: #4ba264;
}

.step-toggle-arrow {
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 10rpx solid #4ba264;
  margin-left: 10rpx;
  transition: transform 0.2s;
}

.step-toggle-arrow.open {
  transform: rotate(180deg);
}

/* 来源 */
.source-section {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #ececec;
}

.source-label {
  display: block;
  font-size: 26rpx;
  color: #8a8f98;
  margin-bottom: 12rpx;
}

.source-text {
  display: block;
  font-size: 26rpx;
  color: #3a3f45;
  line-height: 1.5;
}

/* 相关推荐 */
.related-section {
  padding: 48rpx 32rpx 0;
}

.related-item {
  margin-bottom: 24rpx;
}

/* 底部操作栏 */
.article-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 32rpx;
  /* 按钮下方留出避开屏幕圆角/小横条的基础空白，再叠加系统安全区高度。
     iPhone 的 safe-area-inset-bottom 本身就接近手势条高度，基础值按最小可用取，避免底栏显得空 */
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(31, 41, 36, 0.06);
  z-index: 100;
}

.footer-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  flex: none;
}

.footer-fav .footer-icon {
  margin-right: 0;
}

.footer-fav-text {
  font-size: 20rpx;
  color: #8a8f98;
  margin-top: 4rpx;
}

.footer-fav-text.active {
  color: #fa8700;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.footer-btn-solid {
  background: #4ba264;
  color: #ffffff;
  margin: 0;
  padding: 0;
}

.footer-btn-solid::after {
  border: none;
}

.footer-btn-outline {
  background: #ffffff;
  color: #4ba264;
  border: 2rpx solid #4ba264;
}

.footer-btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.footer-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.footer-icon.pop {
  animation: star-pop 0.3s ease;
}

@keyframes star-pop {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
  }
}

/* 分享到朋友圈引导：暗罩在导航之下（导航保持亮），内容层在导航之上 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 900;
}

.guide-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-ring {
  position: absolute;
  border: 4rpx solid #6ee7b0;
  border-radius: 50%;
  box-shadow: 0 0 24rpx rgba(110, 231, 176, 0.8);
}

.guide-arrow {
  position: absolute;
  width: 164rpx;
  height: 164rpx;
}

.guide-steps {
  margin-top: 320rpx;
  width: 100%;
  padding: 0 110rpx;
}

.guide-step {
  display: flex;
  align-items: center;
  margin-bottom: 56rpx;
}

.guide-num {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #6ee7b0;
  color: #0f2b1c;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.guide-step-text {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 700;
}

.guide-tile {
  width: 250rpx;
  background: #f7f8f7;
  border-radius: 24rpx;
  padding: 32rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
}

.guide-tile-icon {
  width: 88rpx;
  height: 88rpx;
}

.guide-tile-text {
  font-size: 26rpx;
  color: #1f2924;
  margin-top: 16rpx;
}

.guide-tagline {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 40rpx;
}

.guide-know {
  margin-top: 64rpx;
  height: 88rpx;
  padding: 0 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 双击点赞 */
.like-burst {
  position: fixed;
  z-index: 300;
  width: 0;
  height: 0;
  pointer-events: none;
}

.like-burst-icon {
  position: absolute;
  left: -60rpx;
  top: -60rpx;
  width: 120rpx;
  height: 120rpx;
  animation: like-pop 0.7s ease forwards;
}

@keyframes like-pop {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  30% {
    transform: scale(1.25);
    opacity: 1;
  }
  60% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.1) translateY(-40rpx);
    opacity: 0;
  }
}
