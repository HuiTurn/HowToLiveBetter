<!-- 富文本 runs 模板：普通文本 / **加粗** / 条号上标（点击跳转） -->
<template name="rich-runs">
  <block wx:for="{{runs}}" wx:for-item="run" wx:key="index">
    <text
      wx:if="{{run.ref}}"
      class="cite-sup"
      catchtap="onCiteTap"
      data-step="{{run.ref.step}}"
      data-to="{{run.ref.to}}"
    >{{run.t}}</text>
    <text
      wx:elif="{{run.term}}"
      class="term {{run.b ? boldCls : ''}}"
      catchtap="onTermTap"
      data-k="{{run.t}}"
    >{{run.t}}</text>
    <text wx:else class="{{run.b ? boldCls : ''}}">{{run.t}}</text>
  </block>
</template>

<view class="page article-page">
  <custom-nav title="" back="{{true}}" bg-color="var(--color-surface, #ffffff)" text-color="var(--color-text, #22262b)" shadow="{{false}}" />

  <view wx:if="{{article}}" class="article-content" bindtap="onContentTap">
    <!-- 封面图 -->
    <image class="article-cover" src="{{article.cover}}" mode="aspectFill" />

    <!-- 标题区 -->
    <view class="article-header">
      <text class="article-title">{{article.title}}</text>
      <view class="article-meta">
        <view class="article-date">
          <image class="date-icon" src="/assets/icons/clock-gray.png" mode="aspectFit" />
          <text wx:if="{{article.updatedAt}}" class="date-upd">更新于 {{article.updatedAt}}</text>
          <text class="date-sep">·</text>
          <text class="date-pub">发布于 {{article.publishedAt || article.date}}</text>
        </view>
      </view>
    </view>

    <!-- 摘要 -->
    <view class="article-summary-box">
      <template is="rich-runs" data="{{runs: article.summaryRuns, boldCls: ''}}" />
    </view>

    <!-- 正文 -->
    <view class="article-body">
      <block wx:if="{{article.content.length > 0}}">
        <view class="section-title">为什么要这样做？</view>
        <view wx:for="{{article.content}}" wx:key="index" class="article-paragraph">
          <template is="rich-runs" data="{{runs: item, boldCls: 'para-bold'}}" />
        </view>
      </block>

      <!-- 步骤列表 -->
      <view wx:if="{{article.steps && article.steps.length > 0}}" class="steps-section">
        <view class="section-title">具体方法</view>
        <view wx:for="{{article.steps}}" wx:key="index" id="step-{{item.index}}" class="step-item {{item.flash ? 'flash' : ''}}">
          <view class="step-head">
            <view class="step-index">
              <text>{{item.index}}</text>
            </view>
            <text class="step-title">{{item.title}}</text>
            <text class="badge badge-grade-{{item.grade}}">{{item.grade}}</text>
          </view>

          <view class="step-badges">
            <text class="badge badge-ratio-{{item.ratioKey}}">性价比 {{item.meta.ratio}}</text>
            <text class="badge badge-grade-{{item.grade}}">证据 {{item.grade}} 级</text>
            <text wx:if="{{item.lensText}}" class="badge badge-plain">{{item.lensText}}</text>
            <text
              wx:for="{{item.costTags}}"
              wx:for-item="tag"
              wx:key="*this"
              class="badge badge-plain"
            >{{tag}}</text>
            <text wx:if="{{item.meta.dispute}}" class="badge badge-danger">争议</text>
            <text wx:if="{{item.meta.todo}}" class="badge badge-warn">含待核实</text>
          </view>

          <view wx:if="{{item.plain}}" class="step-plain">
            <template is="rich-runs" data="{{runs: item.plainRuns, boldCls: ''}}" />
          </view>

          <!-- 成本：独立展开/收起，默认展开（与收益/备注同款交互） -->
          <view wx:if="{{item.cost}}" class="fold-toggle" catchtap="onToggleFold" data-idx="{{index}}" data-field="costOpen">
            <view class="fold-arrow {{item.costOpen ? 'open' : ''}}"></view>
            <text>成本</text>
          </view>
          <view wx:if="{{item.cost && item.costOpen}}" class="step-rows">
            <view class="step-row">
              <text class="row-v row-v-only"><template is="rich-runs" data="{{runs: item.costRuns, boldCls: 'row-bold'}}" /></text>
            </view>
          </view>

          <!-- 收益：独立展开/收起，默认展开 -->
          <view wx:if="{{item.gain}}" class="fold-toggle" catchtap="onToggleFold" data-idx="{{index}}" data-field="gainOpen">
            <view class="fold-arrow {{item.gainOpen ? 'open' : ''}}"></view>
            <text>收益</text>
          </view>
          <view wx:if="{{item.gain && item.gainOpen}}" class="step-rows">
            <view class="step-row">
              <text class="row-v row-v-only"><template is="rich-runs" data="{{runs: item.gainRuns, boldCls: 'row-bold'}}" /></text>
            </view>
          </view>

          <!-- 备注：独立展开/收起，默认展开 -->
          <view wx:if="{{item.note}}" class="fold-toggle" catchtap="onToggleFold" data-idx="{{index}}" data-field="noteOpen">
            <view class="fold-arrow {{item.noteOpen ? 'open' : ''}}"></view>
            <text>备注</text>
          </view>
          <view wx:if="{{item.note && item.noteOpen}}" class="step-rows">
            <view class="step-row">
              <text class="row-v row-v-only row-note"><template is="rich-runs" data="{{runs: item.noteRuns, boldCls: 'row-bold'}}" /></text>
            </view>
          </view>

          <!-- 参考文献：默认收起，点开看文献与链接 -->
          <view wx:if="{{item.source}}" class="fold-toggle" catchtap="onToggleFold" data-idx="{{index}}" data-field="refsOpen">
            <view class="fold-arrow {{item.refsOpen ? 'open' : ''}}"></view>
            <text>来源</text>
            <text class="fold-cnt">（{{item.refCount}} 条文献）</text>
          </view>
          <view wx:if="{{item.source && item.refsOpen}}" class="src-body">
            <view
              wx:for="{{item.refList}}"
              wx:for-item="ref"
              wx:for-index="ri"
              wx:key="ri"
              class="src-line"
            >
              <text class="src-idx">[{{ri + 1}}]</text>
              <view class="src-line-txt">
                <block wx:for="{{ref.runs}}" wx:for-item="run" wx:key="index">
                  <text wx:if="{{run.url}}" class="src-url" catchtap="onCopyRefUrl" data-url="{{run.t}}">{{run.t}}</text>
                  <text wx:else>{{run.t}}</text>
                </block>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 来源 -->
      <view wx:if="{{article.source}}" class="source-section">
        <text class="source-label">来源 / 参考</text>
        <text class="source-text">{{article.source}}</text>
      </view>
    </view>

    <!-- 相关推荐 -->
    <view wx:if="{{relatedArticles.length > 0}}" class="related-section">
      <view class="section-title">相关推荐</view>
      <view wx:for="{{relatedArticles}}" wx:key="id" class="related-item">
        <article-card article="{{item}}" show-category="{{false}}" bind:favorite="onCardFavorite" />
      </view>
    </view>

    <!-- 双击点赞爆心 -->
    <view wx:if="{{burstShow}}" class="like-burst" style="left:{{burstX}}px; top:{{burstY}}px;">
      <image class="like-burst-icon" src="/assets/icons/heart-red.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view wx:if="{{article}}" class="article-footer safe-bottom">
    <view class="footer-fav" bindtap="onFavorite" hover-class="hover-press">
      <image
        class="footer-icon {{starPop ? 'pop' : ''}}"
        src="{{isFavorite ? '/assets/icons/star-orange.png' : '/assets/icons/star.png'}}"
        mode="aspectFit"
      />
      <text class="footer-fav-text {{isFavorite ? 'active' : ''}}">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="footer-btn footer-btn-solid" open-type="share" hover-class="hover-press">
      <image class="footer-btn-icon" src="/assets/icons/share-white.png" mode="aspectFit" />
      <text>转发好友</text>
    </button>
    <view class="footer-btn footer-btn-outline" bindtap="onShowTimelineGuide" hover-class="hover-press">
      <image class="footer-btn-icon" src="/assets/icons/moments-green.png" mode="aspectFit" />
      <text>转发到朋友圈</text>
    </view>
  </view>

  <!-- 分享到朋友圈引导蒙层 -->
  <view wx:if="{{showGuide}}" class="guide-mask" catchtap="onCloseGuide"></view>
  <view wx:if="{{showGuide}}" class="guide-layer" catchtap="onCloseGuide">
    <view class="guide-ring" style="top:{{ringTop}}px; left:{{ringLeft}}px; width:{{ringSize}}px; height:{{ringSize}}px;"></view>
    <image
      class="guide-arrow"
      src="/assets/icons/arrow-curve-white.png"
      mode="aspectFit"
      style="top:{{arrowTop}}px; right:{{arrowRight}}px;"
    />
    <view class="guide-steps">
      <view class="guide-step">
        <view class="guide-num">1</view>
        <text class="guide-step-text">点击右上角「···」</text>
      </view>
      <view class="guide-step">
        <view class="guide-num">2</view>
        <text class="guide-step-text">选择「分享到朋友圈」</text>
      </view>
    </view>
    <view class="guide-tile">
      <image class="guide-tile-icon" src="/assets/icons/moments-green.png" mode="aspectFit" />
      <text class="guide-tile-text">分享到朋友圈</text>
    </view>
    <text class="guide-tagline">让朋友也能发现这份精彩</text>
    <view class="guide-know">我知道了</view>
  </view>

  <!-- 名词解释：点正文关键词弹出的底部小窗 -->
  <view wx:if="{{termShow}}" class="term-mask" bindtap="onCloseTerm" catchtouchmove="onNoop">
    <view class="term-sheet" catchtap="onNoop">
      <view class="term-grip"></view>
      <view class="term-head">
        <text class="term-k">{{term.k}}</text>
        <view class="term-close" catchtap="onCloseTerm">
          <text class="term-close-x">✕</text>
        </view>
      </view>
      <scroll-view scroll-y class="term-body">
        <text class="term-d">{{term.d}}</text>
      </scroll-view>
      <view class="term-foot">
        <text class="term-from">本书术语表 · 读懂数字</text>
        <view class="term-btn" catchtap="onCloseTerm">知道了</view>
      </view>
    </view>
  </view>
</view>
