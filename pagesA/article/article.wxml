<view class="page article-page">
  <custom-nav title="" back="{{true}}" bg-color="#ffffff" text-color="#22262b" shadow="{{false}}" />

  <view wx:if="{{article}}" class="article-content" bindtap="onContentTap">
    <!-- 封面图 -->
    <image class="article-cover" src="{{article.cover}}" mode="aspectFill" />

    <!-- 标题区 -->
    <view class="article-header">
      <text class="article-title">{{article.title}}</text>
      <view class="article-meta">
        <view class="meta-left">
          <image class="meta-icon" src="{{isLiked ? '/assets/icons/heart-red.png' : '/assets/icons/heart.png'}}" mode="aspectFit" />
        </view>
        <text class="article-date">{{article.date}}</text>
      </view>
    </view>

    <!-- 摘要 -->
    <view class="article-summary-box">
      <text>{{article.summary}}</text>
    </view>

    <!-- 正文 -->
    <view class="article-body">
      <block wx:if="{{article.content.length > 0}}">
        <view class="section-title">为什么要这样做？</view>
        <view wx:for="{{article.content}}" wx:key="index" class="article-paragraph">
          {{item}}
        </view>
      </block>

      <!-- 步骤列表 -->
      <view wx:if="{{article.steps && article.steps.length > 0}}" class="steps-section">
        <view class="section-title">具体方法</view>
        <view wx:for="{{article.steps}}" wx:key="index" class="step-item">
          <view class="step-head">
            <view class="step-index">
              <text>{{item.index}}</text>
            </view>
            <text class="step-title">{{item.title}}</text>
            <text class="badge badge-grade-{{item.grade}}">{{item.grade}}</text>
          </view>

          <view class="step-badges">
            <text class="badge badge-ratio-{{item.ratioKey}}">性价比 {{item.meta.ratio}}</text>
            <text class="badge badge-grade-{{item.grade}}">证据 {{item.grade}} 级</text>
            <text wx:if="{{item.lensText}}" class="badge badge-plain">{{item.lensText}}</text>
            <text
              wx:for="{{item.costTags}}"
              wx:for-item="tag"
              wx:key="*this"
              class="badge badge-plain"
            >{{tag}}</text>
            <text wx:if="{{item.meta.dispute}}" class="badge badge-danger">争议</text>
            <text wx:if="{{item.meta.todo}}" class="badge badge-warn">含待核实</text>
          </view>

          <view wx:if="{{item.plain}}" class="step-plain">{{item.plain}}</view>

          <view class="step-rows">
            <view wx:if="{{item.cost}}" class="step-row">
              <text class="row-k">成本</text>
              <text class="row-v">{{item.cost}}</text>
            </view>
          </view>

          <view
            wx:if="{{item.gain || item.note}}"
            class="step-toggle"
            catchtap="onToggleStep"
            data-idx="{{index}}"
          >
            <text>{{item.open ? '收起收益与备注' : '展开收益与备注'}}</text>
            <view class="step-toggle-arrow {{item.open ? 'open' : ''}}"></view>
          </view>

          <view wx:if="{{item.open}}" class="step-more">
            <view wx:if="{{item.gain}}" class="step-row">
              <text class="row-k">收益</text>
              <text class="row-v">{{item.gain}}</text>
            </view>
            <view wx:if="{{item.note}}" class="step-row">
              <text class="row-k">备注</text>
              <text class="row-v row-note">{{item.note}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 来源 -->
      <view wx:if="{{article.source}}" class="source-section">
        <text class="source-label">来源 / 参考</text>
        <text class="source-text">{{article.source}}</text>
      </view>
    </view>

    <!-- 相关推荐 -->
    <view wx:if="{{relatedArticles.length > 0}}" class="related-section">
      <view class="section-title">相关推荐</view>
      <view wx:for="{{relatedArticles}}" wx:key="id" class="related-item">
        <article-card article="{{item}}" show-category="{{false}}" bind:favorite="onCardFavorite" />
      </view>
    </view>

    <!-- 双击点赞爆心 -->
    <view wx:if="{{burstShow}}" class="like-burst" style="left:{{burstX}}px; top:{{burstY}}px;">
      <image class="like-burst-icon" src="/assets/icons/heart-red.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view wx:if="{{article}}" class="article-footer safe-bottom">
    <view class="footer-fav" bindtap="onFavorite" hover-class="hover-press">
      <image
        class="footer-icon {{starPop ? 'pop' : ''}}"
        src="{{isFavorite ? '/assets/icons/star-orange.png' : '/assets/icons/star.png'}}"
        mode="aspectFit"
      />
      <text class="footer-fav-text {{isFavorite ? 'active' : ''}}">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="footer-btn footer-btn-solid" open-type="share" hover-class="hover-press">
      <image class="footer-btn-icon" src="/assets/icons/share-white.png" mode="aspectFit" />
      <text>转发好友</text>
    </button>
    <view class="footer-btn footer-btn-outline" bindtap="onShowTimelineGuide" hover-class="hover-press">
      <image class="footer-btn-icon" src="/assets/icons/moments-green.png" mode="aspectFit" />
      <text>朋友圈</text>
    </view>
  </view>

  <!-- 分享到朋友圈引导蒙层 -->
  <view wx:if="{{showGuide}}" class="guide-mask" catchtap="onCloseGuide"></view>
  <view wx:if="{{showGuide}}" class="guide-layer" catchtap="onCloseGuide">
    <view class="guide-ring" style="top:{{ringTop}}px; left:{{ringLeft}}px; width:{{ringSize}}px; height:{{ringSize}}px;"></view>
    <image
      class="guide-arrow"
      src="/assets/icons/arrow-curve-white.png"
      mode="aspectFit"
      style="top:{{arrowTop}}px; right:{{arrowRight}}px;"
    />
    <view class="guide-steps">
      <view class="guide-step">
        <view class="guide-num">1</view>
        <text class="guide-step-text">点击右上角「···」</text>
      </view>
      <view class="guide-step">
        <view class="guide-num">2</view>
        <text class="guide-step-text">选择「分享到朋友圈」</text>
      </view>
    </view>
    <view class="guide-tile">
      <image class="guide-tile-icon" src="/assets/icons/moments-green.png" mode="aspectFit" />
      <text class="guide-tile-text">分享到朋友圈</text>
    </view>
    <text class="guide-tagline">让朋友也能发现这份精彩</text>
    <view class="guide-know">我知道了</view>
  </view>
</view>
