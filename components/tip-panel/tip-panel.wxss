/* 赞助弹窗：颜色全部走 variables.wxss 变量，深色模式自动跟随 */
.tip-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 220ms ease;
  z-index: 1000;
}

.tip-mask-on {
  opacity: 1;
}

.tip-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 220ms ease;
  z-index: 1001;
}

.tip-sheet-on {
  transform: translateY(0);
}

.tip-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.tip-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

.tip-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--color-text-tertiary);
}

.tip-intro {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.tip-tiers {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.tip-tier {
  width: calc(33.333% - 16rpx);
  box-sizing: border-box;
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-surface-2);
  transition: border-color 160ms ease, background-color 160ms ease;
}

.tip-tier-on {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

.tip-tier-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.tip-tier-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  background: var(--color-surface-2);
}

.tip-tier-desc {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.4;
}

.tip-tier-skeleton {
  height: 96rpx;
  background: var(--color-surface-2);
  border-color: var(--color-surface-2);
}

.tip-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  margin-bottom: 32rpx;
}

.tip-error-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 24rpx;
}

.tip-retry {
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: 26rpx;
}

.tip-confirm {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.tip-confirm-off {
  opacity: 0.45;
}

.tip-pay-error {
  display: block;
  font-size: 24rpx;
  color: var(--badge-red-text);
  line-height: 1.5;
  margin-top: 20rpx;
}

.tip-note {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
  margin-top: 20rpx;
}

.tip-done {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 48rpx;
}

.tip-done-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.75;
}

.tip-done-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.tip-done-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}
