.loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #4ba264;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.loading-small .spinner {
  width: 24rpx;
  height: 24rpx;
  border-width: 3rpx;
}

.loading-large .spinner {
  width: 64rpx;
  height: 64rpx;
  border-width: 6rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
