.article-card {
  position: relative;
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(31, 41, 36, 0.04);
}

/* horizontal layout */
.horizontal {
  flex-direction: row;
  padding: 24rpx;
  align-items: center;
}

.horizontal .article-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #eef0f0;
}

.horizontal .article-content {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

/* vertical layout */
.vertical {
  flex-direction: column;
}

.vertical .article-cover {
  width: 100%;
  height: 240rpx;
}

.vertical .article-content {
  padding: 24rpx;
}

.article-category {
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.article-category-below {
  font-size: 24rpx;
  color: #8a8f98;
  margin-bottom: 12rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #22262b;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.article-summary {
  font-size: 24rpx;
  color: #8a8f98;
  line-height: 1.5;
  max-height: 72rpx;
  overflow: hidden;
}

.star-btn {
  position: absolute;
  right: 28rpx;
  top: calc(50% - 20rpx);
  width: 40rpx;
  height: 40rpx;
  padding: 6rpx;
}

.star-btn.pop {
  animation: star-pop 0.3s ease;
}

@keyframes star-pop {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.3);
  }
  100% {
    transform: scale(1);
  }
}
